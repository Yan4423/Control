{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "STM32: Build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "STM32: Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "STM32: Flash with ST-Link",
      "type": "process",
      "command": "STM32_Programmer_CLI",
      "args": [
        "-c",
        "port=SWD",
        "mode=UR",
        "reset=HWrst",
        "freq=1000",
        "-w",
        "build/Debug/rf206s_motor_test.elf",
        "-v",
        "-rst"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "STM32: Build Debug",
      "problemMatcher": []
    }
  ]
}
