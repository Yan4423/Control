+static void buzzer_init(void)
+{
+  GPIO_InitTypeDef gpio_init = {0};
+  TIM_OC_InitTypeDef pwm_config = {0};
+
+  /* TIM4 is on APB1.  The 84 MHz timer clock is divided to 1 MHz, then 4 kHz. */
+  __HAL_RCC_TIM4_CLK_ENABLE();
+  __HAL_RCC_GPIOD_CLK_ENABLE();
+
+  gpio_init.Pin = GPIO_PIN_14;
+  gpio_init.Mode = GPIO_MODE_AF_PP;
+  gpio_init.Pull = GPIO_NOPULL;
+  gpio_init.Speed = GPIO_SPEED_FREQ_LOW;
+  gpio_init.Alternate = GPIO_AF2_TIM4;
+  HAL_GPIO_Init(GPIOD, &gpio_init);
+
+  buzzer_timer.Instance = TIM4;
+  buzzer_timer.Init.Prescaler = BUZZER_TIMER_PRESCALER;
+  buzzer_timer.Init.CounterMode = TIM_COUNTERMODE_UP;
+  buzzer_timer.Init.Period = BUZZER_TIMER_PERIOD;
+  buzzer_timer.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
+  buzzer_timer.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_DISABLE;
+  if (HAL_TIM_PWM_Init(&buzzer_timer) != HAL_OK)
+  {
+    Error_Handler();
+  }
+
+  pwm_config.OCMode = TIM_OCMODE_PWM1;
+  pwm_config.Pulse = 0U;
+  pwm_config.OCPolarity = TIM_OCPOLARITY_HIGH;
+  pwm_config.OCFastMode = TIM_OCFAST_DISABLE;
+  if (HAL_TIM_PWM_ConfigChannel(&buzzer_timer,
+                                &pwm_config,
+                                TIM_CHANNEL_3) != HAL_OK)
+  {
+    Error_Handler();
+  }
+
+  if (HAL_TIM_PWM_Start(&buzzer_timer, TIM_CHANNEL_3) != HAL_OK)
+  {
+    Error_Handler();
+  }
+
+  buzzer_set_output(0U);
+}
+
+static void buzzer_set_output(uint8_t enabled)
+{
+  __HAL_TIM_SET_COMPARE(&buzzer_timer,
+                        TIM_CHANNEL_3,
+                        (enabled != 0U) ? BUZZER_TIMER_PULSE : 0U);
+}
+
+static void buzzer_request_event(uint8_t event)
+{
+  buzzer_pending_events |= event;
+}
+
+static void buzzer_update(uint32_t now)
+{
+  if (buzzer_state == BUZZER_STATE_IDLE)
+  {
+    if ((buzzer_pending_events & BUZZER_EVENT_BOOT) != 0U)
+    {
+      buzzer_pending_events &= (uint8_t)~BUZZER_EVENT_BOOT;
+      buzzer_set_output(1U);
+      buzzer_state = BUZZER_STATE_BOOT_ON;
+      buzzer_state_deadline = now + BUZZER_BOOT_BEEP_MS;
+    }
+    else if ((buzzer_pending_events & BUZZER_EVENT_LINK) != 0U)
+    {
+      buzzer_pending_events &= (uint8_t)~BUZZER_EVENT_LINK;
+      buzzer_set_output(1U);
+      buzzer_state = BUZZER_STATE_LINK_ON;
+      buzzer_state_deadline = now + BUZZER_SHORT_BEEP_MS;
+    }
+    else if ((buzzer_pending_events & BUZZER_EVENT_ARMED) != 0U)
+    {
+      buzzer_pending_events &= (uint8_t)~BUZZER_EVENT_ARMED;
+      buzzer_set_output(1U);
+      buzzer_state = BUZZER_STATE_ARMED_ON_1;
+      buzzer_state_deadline = now + BUZZER_SHORT_BEEP_MS;
+    }
+    return;
+  }
+
+  if ((int32_t)(now - buzzer_state_deadline) < 0)
+  {
+    return;
+  }
+
+  switch (buzzer_state)
+  {
+    case BUZZER_STATE_BOOT_ON:
+    case BUZZER_STATE_LINK_ON:
+      buzzer_set_output(0U);
+      buzzer_state = BUZZER_STATE_IDLE;
+      break;
+
+    case BUZZER_STATE_ARMED_ON_1:
+      buzzer_set_output(0U);
+      buzzer_state = BUZZER_STATE_ARMED_GAP;
+      buzzer_state_deadline = now + BUZZER_BEEP_GAP_MS;
+      break;
+
+    case BUZZER_STATE_ARMED_GAP:
+      buzzer_set_output(1U);
+      buzzer_state = BUZZER_STATE_ARMED_ON_2;
+      buzzer_state_deadline = now + BUZZER_SHORT_BEEP_MS;
+      break;
+
+    case BUZZER_STATE_ARMED_ON_2:
+    default:
+      buzzer_set_output(0U);
+      buzzer_state = BUZZER_STATE_IDLE;
+      break;
+  }
+}
+
+static void buzzer_detect_drive_events(void)
+{
+  if ((drive_link_ok != 0U) && (buzzer_previous_link_ok == 0U))
+  {
+    buzzer_request_event(BUZZER_EVENT_LINK);
+  }
+  if ((drive_armed != 0U) && (buzzer_previous_armed == 0U))
+  {
+    buzzer_request_event(BUZZER_EVENT_ARMED);
+  }
+
+  buzzer_previous_link_ok = drive_link_ok;
+  buzzer_previous_armed = drive_armed;
+}
